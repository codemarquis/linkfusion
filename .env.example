# Copy to .env for local development (the dev server reads real environment
# variables; e.g. `set -a; source .env; set +a; npm run dev`, or use docker compose).

# Required
DATABASE_URL=postgresql://linkfusion:linkfusion@localhost:5432/linkfusion

# Required in production (32+ random characters: openssl rand -hex 32).
# In development a random secret is generated per start (sessions reset on restart).
SESSION_SECRET=

# Public address of the app. Required in production and must be https://.
# Short links and OAuth callbacks are built from it; it is also the only Origin
# allowed to make state-changing requests (CSRF protection).
PUBLIC_BASE_URL=http://localhost:3000

# Number of reverse-proxy hops in front of the app (1 behind an ALB/Nginx, 0 locally).
TRUST_PROXY=0

# Bind address and port. Use HOST=0.0.0.0 inside containers.
HOST=127.0.0.1
PORT=3000

# Serve the built client without the Vite dev server (local Docker only).
# SERVE_STATIC=true

# Apply database migrations at start-up.
MIGRATE_ON_START=true

# Optional sign-in providers (see docs/oauth.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
